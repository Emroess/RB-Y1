#!/usr/bin/env python3
"""
RB-Y1 RobotState health check (observe-only).

Streams RobotState at a target rate while the robot is POWERED BUT STATIONARY,
then characterizes:
  - timing fidelity (real dt distribution vs the nominal period)
  - effective sample rate / dropped samples
  - F/T sensor noise floor and at-rest bias (per axis, both arms)
  - data integrity (NaN/Inf, readiness, fault/EMO flags)

It does NOT enable servos and does NOT command motion. Run this first.

NOTE: rby1_sdk API names move between versions. The streaming entry point used
here is `start_state_update(callback, rate)` / `stop_state_update()`, and state
fields follow the v0.10-era proto. If a call fails, check your installed wheel's
Python API reference and adjust the marked lines.
"""

import sys
import time
import math
import argparse

import numpy as np

try:
    import rby1_sdk as rby
except ImportError:
    sys.exit("rby1_sdk not importable in this environment. Run on the U-PC.")


# ----------------------------- timestamp helper -----------------------------
def device_time_seconds(ts):
    """Best-effort conversion of RobotState.timestamp to float seconds.

    The binding may expose it as a datetime, a (sec, nsec) struct, or a number.
    We don't rely on it for the primary timing analysis (we use the host clock),
    but we capture it to check device-vs-host clock agreement.
    """
    if ts is None:
        return math.nan
    # datetime-like
    if hasattr(ts, "timestamp") and callable(getattr(ts, "timestamp")):
        try:
            return float(ts.timestamp())
        except Exception:
            pass
    # protobuf Timestamp-like
    for sec_attr, nsec_attr in (("seconds", "nanos"), ("tv_sec", "tv_nsec")):
        if hasattr(ts, sec_attr):
            return float(getattr(ts, sec_attr)) + float(getattr(ts, nsec_attr, 0)) * 1e-9
    # plain number (assume seconds)
    try:
        return float(ts)
    except Exception:
        return math.nan


def ft_xyz(ft):
    """Return [Fx,Fy,Fz,Tx,Ty,Tz] from an FTSensorData, NaN-filled on failure."""
    try:
        f, t = ft.force, ft.torque
        return [f.x, f.y, f.z, t.x, t.y, t.z]
    except Exception:
        return [math.nan] * 6


# ----------------------------- collection -----------------------------------
def collect(address, model, duration_s, rate_hz):
    robot = rby.create_robot(address, model)        # <-- API: create_robot(addr, "a")
    if not robot.connect():                          # <-- API: connect()
        sys.exit(f"Could not connect to robot at {address}")

    info = robot.get_robot_info()                    # <-- API: get_robot_info()
    print("Connected. Robot info:")
    print(f"  {info}\n")

    host_t, dev_t = [], []
    ftR, ftL, pos = [], [], []
    flags = {"not_ready": 0, "emo": 0, "collision": 0}

    def on_state(state):
        host_t.append(time.perf_counter())
        dev_t.append(device_time_seconds(getattr(state, "timestamp", None)))
        ftR.append(ft_xyz(state.ft_sensor_right))    # <-- API: dual 6-DoF F/T
        ftL.append(ft_xyz(state.ft_sensor_left))
        try:
            pos.append(list(state.position))         # 24 actuators
        except Exception:
            pos.append([math.nan])
        # cheap integrity flags
        try:
            if not all(state.is_ready):
                flags["not_ready"] += 1
        except Exception:
            pass
        if getattr(state, "emo_states", None):
            flags["emo"] += 1 if len(state.emo_states) else 0
        if getattr(state, "collisions", None):
            flags["collision"] += 1 if len(state.collisions) else 0

    print(f"Streaming for {duration_s}s at target {rate_hz} Hz. Keep the robot STILL.")
    robot.start_state_update(on_state, rate_hz)      # <-- API: start_state_update(cb, rate)
    t0 = time.perf_counter()
    time.sleep(duration_s)
    robot.stop_state_update()                        # <-- API: stop_state_update()
    elapsed = time.perf_counter() - t0
    robot.disconnect()

    return {
        "elapsed": elapsed,
        "rate_hz": rate_hz,
        "host_t": np.array(host_t, dtype=float),
        "dev_t": np.array(dev_t, dtype=float),
        "ftR": np.array(ftR, dtype=float),
        "ftL": np.array(ftL, dtype=float),
        "pos": np.array(pos, dtype=float) if pos and len(pos[0]) > 1 else None,
        "flags": flags,
    }


# ----------------------------- analysis --------------------------------------
def analyze(log):
    n = len(log["host_t"])
    nominal_dt = 1.0 / log["rate_hz"]
    expected = int(round(log["elapsed"] * log["rate_hz"]))
    eff_rate = n / log["elapsed"] if log["elapsed"] else float("nan")

    print("\n================ TIMING ================")
    print(f"samples collected : {n}")
    print(f"expected (~)      : {expected}")
    print(f"elapsed           : {log['elapsed']:.3f} s")
    print(f"effective rate    : {eff_rate:.2f} Hz  (nominal {log['rate_hz']} Hz)")

    verdict = []
    if n >= 2:
        dt = np.diff(log["host_t"]) * 1e3  # ms
        p = np.percentile(dt, [50, 95, 99])
        late = np.mean(dt > 1.5 * nominal_dt * 1e3) * 100
        print(f"dt mean / std     : {dt.mean():.2f} / {dt.std():.2f} ms")
        print(f"dt min / max      : {dt.min():.2f} / {dt.max():.2f} ms")
        print(f"dt p50/p95/p99    : {p[0]:.2f} / {p[1]:.2f} / {p[2]:.2f} ms")
        print(f"samples >1.5x dt  : {late:.2f} %  (missed-deadline proxy)")

        if eff_rate < 0.9 * log["rate_hz"]:
            verdict.append("LOW effective rate (>10% below nominal)")
        if dt.std() > 0.5 * nominal_dt * 1e3:
            verdict.append("HIGH jitter (std > 50% of period)")
        if dt.max() > 5 * nominal_dt * 1e3:
            verdict.append(f"large dt spike ({dt.max():.1f} ms)")

        # device-vs-host clock agreement
        dev = log["dev_t"][np.isfinite(log["dev_t"])]
        if dev.size > 2:
            dev_span = dev[-1] - dev[0]
            host_span = log["host_t"][-1] - log["host_t"][0]
            print(f"device/host span  : {dev_span:.3f} / {host_span:.3f} s "
                  f"(drift {1e3*(dev_span-host_span):+.1f} ms)")

    print("\n================ F/T NOISE FLOOR (at rest) ================")
    axes = ["Fx", "Fy", "Fz", "Tx", "Ty", "Tz"]
    units = ["N", "N", "N", "Nm", "Nm", "Nm"]
    for name, arr in (("RIGHT", log["ftR"]), ("LEFT", log["ftL"])):
        print(f"  {name} arm:")
        for i, (ax, u) in enumerate(zip(axes, units)):
            col = arr[:, i]
            col = col[np.isfinite(col)]
            if col.size:
                print(f"    {ax:>2}: bias {col.mean():+8.3f} {u:<2}  "
                      f"noise(std) {col.std():.4f} {u}")
        if not np.all(np.isfinite(arr)):
            verdict.append(f"{name} F/T contains NaN/Inf")
        if np.allclose(np.nan_to_num(arr), 0.0):
            verdict.append(f"{name} F/T all zero (sensor/flange unpowered?)")

    print("\n================ INTEGRITY ================")
    f = log["flags"]
    print(f"frames not-ready  : {f['not_ready']}")
    print(f"frames w/ EMO     : {f['emo']}")
    print(f"frames w/ collision: {f['collision']}")
    if f["not_ready"]:
        verdict.append("robot reported not-ready frames")
    if f["emo"]:
        verdict.append("EMO/e-stop active during capture")

    print("\n================ VERDICT ================")
    if not verdict:
        print("HEALTHY: stream is contiguous, low-jitter, F/T live, no faults.")
    else:
        print("ATTENTION:")
        for v in verdict:
            print(f"  - {v}")
    return verdict


def save_outputs(log, prefix):
    np.savez_compressed(
        f"{prefix}.npz",
        host_t=log["host_t"], dev_t=log["dev_t"],
        ftR=log["ftR"], ftL=log["ftL"],
        pos=log["pos"] if log["pos"] is not None else np.array([]),
    )
    print(f"\nRaw log saved to {prefix}.npz")
    try:
        import matplotlib
        matplotlib.use("Agg")
        import matplotlib.pyplot as plt
        fig, ax = plt.subplots(2, 1, figsize=(9, 7))
        if len(log["host_t"]) > 1:
            dt = np.diff(log["host_t"]) * 1e3
            ax[0].hist(dt, bins=60)
            ax[0].axvline(1e3 / log["rate_hz"], color="k", ls="--", label="nominal dt")
            ax[0].set_xlabel("inter-sample dt (ms)")
            ax[0].set_ylabel("count")
            ax[0].set_title("Timing jitter (host clock)")
            ax[0].legend()
        t = log["host_t"] - log["host_t"][0]
        for i, lbl in enumerate(["Fx", "Fy", "Fz"]):
            ax[1].plot(t, log["ftR"][:, i], label=f"R {lbl}")
        ax[1].set_xlabel("time (s)")
        ax[1].set_ylabel("force (N)")
        ax[1].set_title("Right-arm F/T at rest (noise floor)")
        ax[1].legend(ncol=3, fontsize=8)
        fig.tight_layout()
        fig.savefig(f"{prefix}.png", dpi=120)
        print(f"Plots saved to {prefix}.png")
    except ImportError:
        print("(matplotlib not available; skipped plots)")


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--address", default="192.168.30.1:50051",
                    help="R-PC gRPC address (sim: localhost:50051)")
    ap.add_argument("--model", default="a")
    ap.add_argument("--duration", type=float, default=60.0, help="seconds")
    ap.add_argument("--rate", type=float, default=100.0, help="Hz")
    ap.add_argument("--prefix", default="rby1_healthcheck")
    args = ap.parse_args()

    log = collect(args.address, args.model, args.duration, args.rate)
    analyze(log)
    save_outputs(log, args.prefix)


if __name__ == "__main__":
    main()
